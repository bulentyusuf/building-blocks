CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_PREVIEW_ACCESS_TOKEN=
CONTENTFUL_PREVIEW_SECRET=
CONTENTFUL_REVALIDATE_SECRET=
NEXT_PUBLIC_SITE_URL=
# Optional. Override the site's name, tagline, footer blurb and repository link
# without editing lib/constants.ts. Only needed when one repo feeds several
# deployments and each needs its own identity; leave blank otherwise.
NEXT_PUBLIC_SITE_TITLE=
NEXT_PUBLIC_SITE_DESCRIPTION=
NEXT_PUBLIC_SITE_FOOTER_BLURB=
NEXT_PUBLIC_SITE_REPO_URL=
# Optional. The address published in every RSS <author> element. Left blank the
# element is omitted entirely, which is deliberate: this used to be inferred as
# contact@<your-domain>, so a deployment that set only NEXT_PUBLIC_SITE_URL
# started advertising a mailbox nobody had decided existed.
AUTHOR_EMAIL=
